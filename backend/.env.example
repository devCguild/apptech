# 이 파일을 .env 로 복사해서 쓴다. .env 는 레포에 올리지 않는다.
# 이 API를 부를 수 있는 프론트 주소 (쉼표로 여러 개)
ALLOWED_ORIGINS=https://devcguild.github.io,http://localhost:5173,https://appassets.androidplatform.net
# 공공데이터포털 "전국도시공원정보표준데이터" 인증키 (/api/parks)
DATA_GO_KR_KEY=
# 로컬은 비워 두면 backend/var/apptech.db. Vercel에는 외부 PostgreSQL URL 필수.
DATABASE_URL=
# 실제 키는 이 예제 파일이 아닌 .env 또는 배포 환경 변수에 설정한다.
ADPOPCORN_HASH_KEY=
ADPOPCORN_ENVIRONMENT=test
# 매체 승인과 실서비스 QA 전에는 false 유지. test/live 원장은 분리된다.
ALLOW_LIVE_REWARDS=false
SESSION_TOKEN_TTL_DAYS=30

# Windy Webcams API 키 (https://api.windy.com/keys)
WINDY_API_KEY=
